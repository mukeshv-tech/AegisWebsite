---
import { SITE_TITLE } from '../consts';
---

<header>
  <div class="container">
    <nav>
      <a href="/" class="nav-brand">
        <span>🛡️</span>
        <span class="gradient-text">Aegis</span>
      </a>

      <ul class="nav-links">
        <li><a href="#features">Features</a></li>
        <li><a href="#security">Security Specification</a></li>
        <li><a href="#architecture">Architecture</a></li>
        <li><a href="#qa">Quality Gate</a></li>
        <li><a href="#download">Download</a></li>
      </ul>

      <div class="nav-actions">
        <a href="https://github.com/mukeshv-tech/Aegis" target="_blank" rel="noopener" class="btn btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.875rem;">
          ⭐ GitHub
        </a>
        <a href="https://github.com/mukeshv-tech/Aegis/releases/" target="_blank" rel="noopener" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.875rem;">
          🚀 View Releases (v1.0.0)
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  @media (max-width: 640px) {
    .nav-actions {
      display: none;
    }
  }
</style>
