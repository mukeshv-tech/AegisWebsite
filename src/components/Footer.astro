---
const today = new Date();
---

<footer>
  <div class="container footer-content">
    <div class="footer-brand">
      <div class="brand-title">
        <span>🛡️</span>
        <span class="gradient-text" style="font-weight: 800; font-size: 1.25rem;">Aegis Workstation</span>
      </div>
      <p style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.5rem; max-width: 360px;">
        Zero-trust desktop workstation for DevOps leads, SREs, and security engineers. Scrypt vault encryption, WebGL terminal, SFTP browser, and parallel execution.
      </p>
    </div>

    <div class="footer-column">
      <h4>Navigation</h4>
      <ul>
        <li><a href="#features">Features</a></li>
        <li><a href="#security">Security Specs</a></li>
        <li><a href="#architecture">Architecture</a></li>
        <li><a href="#qa">Automated Tests</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h4>Resources</h4>
      <ul>
        <li><a href="https://github.com/mukeshv-tech/Aegis" target="_blank">GitHub Repository</a></li>
        <li><a href="https://github.com/mukeshv-tech/Aegis/releases" target="_blank">GitHub Releases (v1.0.0)</a></li>
        <li><a href="https://github.com/mukeshv-tech/Aegis/actions" target="_blank">GitHub Actions CI/CD</a></li>
        <li><a href="https://github.com/mukeshv-tech/Aegis/blob/Electron/README.md" target="_blank">Technical Documentation</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {today.getFullYear()} <strong>Aegis</strong> by <a href="https://github.com/mukeshv-tech" target="_blank">Mukesh (@mukeshv-tech)</a>. Built with Electron, React 19, TypeScript, Vite, TailwindCSS, & Astro.</p>
  </div>
</footer>

<style>
  footer {
    background: #06080e;
    border-top: 1px solid var(--border-color);
    padding: 4rem 0 2rem 0;
    margin-top: auto;
  }
  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
  }
  .brand-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .footer-column h4 {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .footer-column ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .footer-column a {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .footer-column a:hover {
    color: var(--accent-cyan);
  }
  .footer-bottom {
    padding-top: 2rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-dim);
  }
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
