---
const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-grid">
    <div class="footer-info">
      <div class="footer-logo">[AEGIS // WORKSTATION]</div>
      <p class="footer-desc">
        Zero-trust remote environment desktop workstation. Built with Electron, React 19, TypeScript 5.7, and Xterm.js v5.5.
      </p>
    </div>

    <div class="footer-col">
      <div class="col-title">Navigation</div>
      <ul>
        <li><a href="/#features">Features</a></li>
        <li><a href="/#security">Security Standard</a></li>
        <li><a href="/#architecture">Architecture</a></li>
        <li><a href="/blog">Blog &amp; Articles</a></li>
        <li><a href="/admin/login">Admin Portal</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <div class="col-title">Resources</div>
      <ul>
        <li><a href="/support">Sponsor Aegis (Razorpay)</a></li>
        <li><a href="https://github.com/mukeshv-tech/Aegis" target="_blank" rel="noopener">GitHub Repository</a></li>
        <li><a href="https://github.com/mukeshv-tech/Aegis/releases/" target="_blank" rel="noopener">Releases Page (v1.0.0)</a></li>
        <li><a href="https://github.com/mukeshv-tech/Aegis/actions" target="_blank" rel="noopener">GitHub Actions CI/CD</a></li>
        <li><a href="https://github.com/mukeshv-tech/Aegis/blob/Electron/README.md" target="_blank" rel="noopener">Technical Documentation</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-meta">
    <span>&copy; {year} Aegis Project. Author: Mukesh (@mukeshv-tech). MIT License.</span>
  </div>
</footer>

<style>
  footer {
    background: var(--bg-primary);
    border-top: 1px solid var(--border-light);
    padding: 5rem 0 3rem 0;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border-light);
  }

  .footer-logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-main);
    margin-bottom: 0.75rem;
  }

  .footer-desc {
    color: var(--text-muted);
    font-size: 0.875rem;
    max-width: 360px;
    line-height: 1.6;
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-col a {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .footer-col a:hover {
    color: var(--text-main);
  }

  .footer-meta {
    padding-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
