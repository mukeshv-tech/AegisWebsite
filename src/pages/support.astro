---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Support Aegis — Open Source Community" description="Support open-source development for Aegis Zero-Trust Remote Environment Workstation." />
	</head>
	<body>
		<Header />

		<main class="support-main">
			<div class="container support-container">
				<div class="mono-tag">Support Open Source</div>
				<h1 class="editorial-title support-heading">Support <em>Aegis Workstation</em></h1>
				<p class="support-desc">
					Aegis is 100% open-source software built for DevOps leads and SREs. You can support the project by contributing code, starring the repository, reporting issues, or spreading the word.
				</p>

				<!-- SUPPORT TIERS GRID -->
				<div class="bento-grid support-grid">
					<!-- Card 1 -->
					<div class="bento-card support-card">
						<div class="card-meta">
							<span class="pastel-tag tag-blue">COMMUNITY</span>
						</div>
						<h3>Star on GitHub</h3>
						<p>Starring the repository helps increase visibility and reaches more DevOps &amp; SRE engineers.</p>
						<a href="https://github.com/mukeshv-tech/Aegis" target="_blank" rel="noopener" class="btn btn-primary">
							Star Repository &rarr;
						</a>
					</div>

					<!-- Card 2 -->
					<div class="bento-card support-card featured-card">
						<div class="card-meta">
							<span class="pastel-tag tag-purple">RECOMMENDED</span>
						</div>
						<h3>Contribute Code</h3>
						<p>Submit bug fixes, performance improvements, or new features directly on GitHub.</p>
						<a href="https://github.com/mukeshv-tech/Aegis/pulls" target="_blank" rel="noopener" class="btn btn-primary">
							View Pull Requests &rarr;
						</a>
					</div>

					<!-- Card 3 -->
					<div class="bento-card support-card">
						<div class="card-meta">
							<span class="pastel-tag tag-green">FEEDBACK</span>
						</div>
						<h3>Report Issues</h3>
						<p>Help us improve by filing detailed bug reports, feature requests, or security feedback.</p>
						<a href="https://github.com/mukeshv-tech/Aegis/issues" target="_blank" rel="noopener" class="btn btn-primary">
							Open Issue &rarr;
						</a>
					</div>
				</div>

				<!-- Documentation Card -->
				<div class="bento-card custom-card">
					<div class="card-meta">
						<span class="pastel-tag tag-amber">DOCUMENTATION</span>
					</div>
					<h3>Read Technical Documentation</h3>
					<p class="custom-desc">Learn more about Aegis architecture, zero-trust workstation security standards, and local development setup.</p>
					<div class="custom-form">
						<a href="https://github.com/mukeshv-tech/Aegis/blob/Electron/README.md" target="_blank" rel="noopener" class="btn btn-secondary">
							Read Documentation &rarr;
						</a>
					</div>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.support-main {
		padding: 5rem 0 7rem 0;
		min-height: 80vh;
	}
	.support-container {
		max-width: 960px;
	}
	.support-heading {
		font-size: 3.25rem;
		margin-top: 0.5rem;
	}
	.support-desc {
		font-size: 1.15rem;
		color: var(--text-muted);
		max-width: 680px;
		margin-top: 1rem;
		margin-bottom: 2.5rem;
		line-height: 1.7;
	}

	.support-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}
	.support-card {
		display: flex;
		flex-direction: column;
		padding: 2.25rem 2rem;
	}
	.featured-card {
		border-color: var(--border-strong);
		background: var(--bg-card);
	}
	.support-card h3 {
		font-size: 1.25rem;
		font-weight: 700;
		margin-bottom: 0.75rem;
		color: var(--text-main);
	}
	.support-card p {
		font-size: 0.875rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin-bottom: 2rem;
	}
	.support-card .btn {
		margin-top: auto;
		width: 100%;
		text-align: center;
		justify-content: center;
	}

	/* Custom Card */
	.custom-card {
		padding: 2.25rem 2rem;
	}
	.custom-card h3 {
		font-size: 1.25rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}
	.custom-desc {
		font-size: 0.875rem;
		color: var(--text-muted);
		margin-bottom: 1.25rem;
	}
	.custom-form {
		display: flex;
		gap: 1rem;
	}
</style>
