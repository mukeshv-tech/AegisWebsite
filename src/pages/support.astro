---
export const prerender = false;

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Cloudflare Geolocation detection header
const countryHeader = Astro.request.headers.get('cf-ipcountry') || Astro.request.headers.get('x-country-code') || '';
const isIndiaRegion = !countryHeader || ['IN', 'BD', 'PK', 'NP', 'LK'].includes(countryHeader.toUpperCase());

const keyId = process.env.PUBLIC_RAZORPAY_KEY_ID || process.env.RAZORPAY_KEY_ID || 'rzp_test_TNbJmoow265Zb0';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Support Aegis — Locality Pricing & Sponsorship" description="Support open-source development for Aegis Zero-Trust Remote Environment Workstation with regional purchasing power parity pricing." />
		<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
	</head>
	<body>
		<amp-auto-ads type="adsense" data-ad-client="ca-pub-5201889113032974"></amp-auto-ads>
		<Header />

		<main class="support-main">
			<div class="container support-container">
				<div class="mono-tag">Support Open Source</div>
				<h1 class="editorial-title support-heading">Sponsor <em>Aegis Workstation</em></h1>
				<p class="support-desc">
					Aegis is 100% open-source software built for DevOps leads and SREs. Your contribution helps fund continuous integration pipelines, security audits, and feature development.
				</p>

				<!-- LOCALITY PRICING BANNER & TOGGLE -->
				<div class="locality-banner">
					<div class="locality-info">
						<span class="pastel-tag tag-blue">📍 LOCALITY PRICING</span>
						<span id="location-label" class="mono-tag">
							{isIndiaRegion ? 'Region: South Asia / India (PPP Adjusted)' : 'Region: International / Global'}
						</span>
					</div>
					<div class="currency-toggle">
						<span class="mono-label">Currency:</span>
						<button type="button" id="toggle-inr" class={`toggle-btn ${isIndiaRegion ? 'active' : ''}`}>₹ INR</button>
						<button type="button" id="toggle-usd" class={`toggle-btn ${!isIndiaRegion ? 'active' : ''}`}>$ USD</button>
					</div>
				</div>

				<!-- TEST MODE WARNING BANNER -->
				<div class="test-mode-banner">
					<div class="banner-meta">
						<span class="pastel-tag tag-amber">⚡ SYSTEM NOTICE</span>
						<span class="mono-tag">ENVIRONMENT: RAZORPAY TEST MODE</span>
					</div>
					<p class="banner-text">
						<strong>Notice:</strong> This checkout system is currently running in <em>Razorpay Test Mode (`rzp_test_...`)</em>. Live production payments are not hooked up yet. No real money will be charged during transactions.
					</p>
				</div>

				<!-- PRICING TIERS GRID -->
				<div class="bento-grid support-grid">
					<!-- Preset 1 -->
					<div class="bento-card support-card">
						<div class="card-meta">
							<span class="pastel-tag tag-blue">SUPPORTER tier</span>
						</div>
						<h3>Community Tier</h3>
						<div class="price-val"><span class="c-symbol">₹</span><span id="price-1">199</span> <span class="c-code">INR</span></div>
						<p>Fund CI runners and automated integration testing matrix.</p>
						<button type="button" class="btn btn-primary pay-btn" data-preset="1">
							Sponsor <span class="c-symbol">₹</span><span id="btn-price-1">199</span> &rarr;
						</button>
					</div>

					<!-- Preset 2 -->
					<div class="bento-card support-card featured-card">
						<div class="card-meta">
							<span class="pastel-tag tag-purple">RECOMMENDED</span>
						</div>
						<h3>Pro Engineer Tier</h3>
						<div class="price-val"><span class="c-symbol">₹</span><span id="price-2">499</span> <span class="c-code">INR</span></div>
						<p>Accelerate WebGL terminal performance &amp; Zmodem feature releases.</p>
						<button type="button" class="btn btn-primary pay-btn" data-preset="2">
							Sponsor <span class="c-symbol">₹</span><span id="btn-price-2">499</span> &rarr;
						</button>
					</div>

					<!-- Preset 3 -->
					<div class="bento-card support-card">
						<div class="card-meta">
							<span class="pastel-tag tag-green">ENTERPRISE tier</span>
						</div>
						<h3>Infrastructure Tier</h3>
						<div class="price-val"><span class="c-symbol">₹</span><span id="price-3">1,499</span> <span class="c-code">INR</span></div>
						<p>Fund security audits and zero-knowledge vault cryptographic hardening.</p>
						<button type="button" class="btn btn-primary pay-btn" data-preset="3">
							Sponsor <span class="c-symbol">₹</span><span id="btn-price-3">1,499</span> &rarr;
						</button>
					</div>
				</div>

				<!-- Custom Amount Input Box -->
				<div class="bento-card custom-card">
					<div class="card-meta">
						<span class="pastel-tag tag-amber">CUSTOM SPONSORSHIP</span>
					</div>
					<h3>Choose Custom Amount</h3>
					<div class="custom-form">
						<div class="input-wrapper">
							<span class="currency-prefix c-symbol">₹</span>
							<input type="number" id="custom-amount" min="1" value="100" step="5" class="custom-input" />
						</div>
						<button type="button" id="custom-pay-btn" class="btn btn-secondary">
							Pay Custom Amount &rarr;
						</button>
					</div>
				</div>

				<!-- Status & Error Alert Container -->
				<div id="payment-status" class="payment-status-box" style="display: none;"></div>
			</div>
		</main>

		<Footer />

		<!-- Client Script for Locality Pricing & Razorpay Integration -->
		<script is:inline define:vars={{ initialIsIndia: isIndiaRegion }}>
			const clientRazorpayKey = "rzp_test_TNbJmoow265Zb0";
			let activeCurrency = initialIsIndia ? 'INR' : 'USD';

			const PRICING_TIERS = {
				INR: {
					symbol: '₹',
					code: 'INR',
					presets: [
						{ value: 199, label: '199', subUnits: 19900, name: 'Community Supporter' },
						{ value: 499, label: '499', subUnits: 49900, name: 'Pro Engineer' },
						{ value: 1499, label: '1,499', subUnits: 149900, name: 'Infrastructure Sponsor' }
					],
					customDefault: 100
				},
				USD: {
					symbol: '$',
					code: 'USD',
					presets: [
						{ value: 5, label: '5', subUnits: 500, name: 'Community Supporter' },
						{ value: 15, label: '15', subUnits: 1500, name: 'Pro Engineer' },
						{ value: 45, label: '45', subUnits: 4500, name: 'Infrastructure Sponsor' }
					],
					customDefault: 10
				}
			};

			function updateLocalityUI(currency) {
				activeCurrency = currency;
				const config = PRICING_TIERS[currency];

				// Update symbols & codes
				document.querySelectorAll('.c-symbol').forEach(el => el.textContent = config.symbol);
				document.querySelectorAll('.c-code').forEach(el => el.textContent = config.code);

				// Update tier values
				config.presets.forEach((preset, idx) => {
					const num = idx + 1;
					const priceEl = document.getElementById(`price-${num}`);
					const btnPriceEl = document.getElementById(`btn-price-${num}`);
					if (priceEl) priceEl.textContent = preset.label;
					if (btnPriceEl) btnPriceEl.textContent = preset.label;
				});

				// Update custom input default value
				const customInput = document.getElementById('custom-amount');
				if (customInput && !customInput.dataset.modified) {
					customInput.value = config.customDefault;
				}

				// Update active toggle buttons
				const btnINR = document.getElementById('toggle-inr');
				const btnUSD = document.getElementById('toggle-usd');
				const locLabel = document.getElementById('location-label');

				if (currency === 'INR') {
					btnINR?.classList.add('active');
					btnUSD?.classList.remove('active');
					if (locLabel) locLabel.textContent = 'Region: South Asia / India (PPP Adjusted)';
				} else {
					btnUSD?.classList.add('active');
					btnINR?.classList.remove('active');
					if (locLabel) locLabel.textContent = 'Region: International / Global';
				}
			}

			function loadRazorpayScript() {
				return new Promise((resolve) => {
					if (window.Razorpay) return resolve(true);
					const script = document.createElement('script');
					script.src = 'https://checkout.razorpay.com/v1/checkout.js';
					script.onload = () => resolve(true);
					script.onerror = () => resolve(false);
					document.head.appendChild(script);
				});
			}

			function showStatus(message, isError) {
				const statusBox = document.getElementById('payment-status');
				if (!statusBox) return;
				statusBox.style.display = 'block';
				statusBox.className = isError ? 'payment-status-box status-error' : 'payment-status-box status-success';
				statusBox.innerHTML = message;
			}

			async function initiateCheckout(amountInSubUnits, currencyCode, description) {
				showStatus('Creating secure Razorpay order...', false);

				const loaded = await loadRazorpayScript();
				if (!loaded) {
					showStatus('Failed to load Razorpay SDK. Please check your internet connection.', true);
					return;
				}

				try {
					const orderRes = await fetch('/api/create-order', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							amount: amountInSubUnits,
							currency: currencyCode,
							receipt: 'rcpt_' + Date.now(),
						}),
					});

					const orderData = await orderRes.json();

					if (!orderRes.ok || !orderData.success) {
						showStatus('Error creating order: ' + (orderData.error || 'Server error'), true);
						return;
					}

					showStatus('Opening Razorpay Payment Modal...', false);

					const options = {
						key: orderData.key_id || clientRazorpayKey,
						amount: orderData.amount,
						currency: orderData.currency,
						name: 'Aegis Workstation',
						description: description || 'Open Source Sponsorship',
						image: '/favicon.svg',
						order_id: orderData.order_id,
						handler: async function (response) {
							showStatus('Verifying payment signature with backend...', false);

							try {
								const verifyRes = await fetch('/api/verify-payment', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({
										razorpay_order_id: response.razorpay_order_id,
										razorpay_payment_id: response.razorpay_payment_id,
										razorpay_signature: response.razorpay_signature,
									}),
								});

								const verifyData = await verifyRes.json();

								if (verifyRes.ok && verifyData.success) {
									showStatus(
										'✅ <strong>Payment Successful!</strong><br />Payment ID: <code>' +
										response.razorpay_payment_id +
										'</code><br />Thank you for supporting Aegis Workstation.',
										false
									);
								} else {
									showStatus(
										'❌ <strong>Payment Verification Failed!</strong><br />' +
										(verifyData.error || 'Invalid payment signature.'),
										true
									);
								}
							} catch (err) {
								showStatus('Error connecting to verification server.', true);
							}
						},
						modal: {
							ondismiss: function () {
								showStatus('Payment cancelled by user.', true);
							},
						},
						theme: {
							color: '#090b0e',
						},
					};

					const rzp = new window.Razorpay(options);

					rzp.on('payment.failed', function (response) {
						showStatus(
							'❌ <strong>Payment Failed!</strong><br />Reason: ' +
							(response.error.description || response.error.reason),
							true
						);
					});

					rzp.open();
				} catch (err) {
					showStatus('Network error while initiating payment: ' + err.message, true);
				}
			}

			function initLocalityPage() {
				// Currency Toggles
				document.getElementById('toggle-inr')?.addEventListener('click', () => updateLocalityUI('INR'));
				document.getElementById('toggle-usd')?.addEventListener('click', () => updateLocalityUI('USD'));

				// Preset Buttons
				document.querySelectorAll('.pay-btn').forEach((btn) => {
					btn.addEventListener('click', (e) => {
						e.preventDefault();
						const presetIndex = parseInt(btn.getAttribute('data-preset') || '1', 10) - 1;
						const config = PRICING_TIERS[activeCurrency];
						const preset = config.presets[presetIndex];

						initiateCheckout(preset.subUnits, config.code, 'Aegis Sponsorship - ' + preset.name);
					});
				});

				// Custom Amount Button
				const customPayBtn = document.getElementById('custom-pay-btn');
				const customInput = document.getElementById('custom-amount');

				customInput?.addEventListener('input', () => {
					customInput.dataset.modified = 'true';
				});

				customPayBtn?.addEventListener('click', (e) => {
					e.preventDefault();
					const val = parseFloat(customInput.value || '10');
					if (isNaN(val) || val < 1) {
						showStatus('Please enter a valid amount (minimum 1).', true);
						return;
					}
					const subUnits = Math.round(val * 100);
					const config = PRICING_TIERS[activeCurrency];

					initiateCheckout(subUnits, config.code, 'Custom Aegis Sponsorship (' + config.code + ')');
				});

				// Initial UI sync
				updateLocalityUI(activeCurrency);
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initLocalityPage);
			} else {
				initLocalityPage();
			}
		</script>
	</body>
</html>

<style>
	.support-main {
		padding: 5rem 0 7rem 0;
		min-height: 80vh;
	}
	.support-container {
		max-width: 960px;
	}
	.support-heading {
		font-size: 3.25rem;
		margin-top: 0.5rem;
	}
	.support-desc {
		font-size: 1.15rem;
		color: var(--text-muted);
		max-width: 680px;
		margin-top: 1rem;
		margin-bottom: 2rem;
		line-height: 1.7;
	}

	/* Locality Pricing Banner */
	.locality-banner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: var(--bg-surface);
		border: 1px solid var(--border-light);
		border-radius: 8px;
		padding: 1rem 1.5rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.locality-info {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.currency-toggle {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.mono-label {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--text-dim);
	}
	.toggle-btn {
		background: var(--bg-primary);
		border: 1px solid var(--border-light);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		padding: 0.35rem 0.85rem;
		border-radius: 4px;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.toggle-btn.active {
		border-color: var(--border-strong);
		color: var(--text-main);
		background: var(--bg-card);
		font-weight: 700;
	}

	/* Test Mode Warning Banner */
	.test-mode-banner {
		background: rgba(245, 158, 11, 0.08);
		border: 1px solid rgba(245, 158, 11, 0.3);
		border-radius: 8px;
		padding: 1.25rem 1.5rem;
		margin-bottom: 3rem;
	}
	.banner-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}
	.banner-text {
		font-size: 0.9rem;
		color: var(--pastel-amber-text);
		line-height: 1.6;
		margin: 0;
	}

	.support-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}
	.support-card {
		display: flex;
		flex-direction: column;
		padding: 2.25rem 2rem;
	}
	.featured-card {
		border-color: var(--border-strong);
		background: var(--bg-card);
	}
	.support-card h3 {
		font-size: 1.25rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
		color: var(--text-main);
	}
	.price-val {
		font-family: var(--font-mono);
		font-size: 2.5rem;
		font-weight: 800;
		color: var(--text-main);
		margin: 0.5rem 0 1rem 0;
	}
	.price-val span.c-code {
		font-size: 1rem;
		font-weight: 400;
		color: var(--text-dim);
	}
	.support-card p {
		font-size: 0.875rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin-bottom: 2rem;
	}
	.support-card .btn {
		margin-top: auto;
		width: 100%;
		cursor: pointer;
	}

	/* Custom Card */
	.custom-card {
		padding: 2.25rem 2rem;
	}
	.custom-card h3 {
		font-size: 1.25rem;
		font-weight: 700;
		margin-bottom: 1.25rem;
	}
	.custom-form {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.input-wrapper {
		display: flex;
		align-items: center;
		background: var(--bg-primary);
		border: 1px solid var(--border-light);
		border-radius: 6px;
		padding: 0 1rem;
		flex: 1;
		min-width: 200px;
	}
	.currency-prefix {
		font-family: var(--font-mono);
		font-size: 1.1rem;
		color: var(--text-muted);
		margin-right: 0.5rem;
	}
	.custom-input {
		background: transparent;
		border: none;
		outline: none;
		color: var(--text-main);
		font-family: var(--font-mono);
		font-size: 1.1rem;
		width: 100%;
		padding: 0.75rem 0;
	}

	/* Payment Status Alert Box */
	.payment-status-box {
		margin-top: 2.5rem;
		padding: 1.25rem 1.75rem;
		border-radius: 8px;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1.7;
	}
	.status-success {
		background: var(--pastel-green-bg);
		border: 1px solid rgba(52, 211, 153, 0.3);
		color: var(--pastel-green-text);
	}
	.status-error {
		background: rgba(248, 113, 113, 0.1);
		border: 1px solid rgba(248, 113, 113, 0.3);
		color: #f87171;
	}
</style>
