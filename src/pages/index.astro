---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<!-- HERO SECTION -->
			<section class="hero-section">
				<div class="container">
					<a href="/blog/v1-0-0-release" class="hero-banner">
						<span class="pastel-tag tag-blue">RELEASE</span>
						<span class="banner-text">Announcing Aegis v1.0.0 GA &rarr;</span>
					</a>
					
					<h1 class="editorial-title hero-heading">
						Command remote infrastructure with <em>zero-trust precision.</em>
					</h1>

					<p class="hero-desc">
						Aegis is a desktop workstation combining a WebGL terminal emulator, zero-knowledge encrypted vault, parallel multi-server script automation, and live system telemetry into a single unified workstation.
					</p>

					<div class="hero-actions">
						<a href="https://github.com/mukeshv-tech/Aegis/releases/" target="_blank" rel="noopener" class="btn btn-primary">
							View Releases (v1.0.0)
						</a>
						<a href="https://github.com/mukeshv-tech/Aegis" target="_blank" rel="noopener" class="btn btn-secondary">
							GitHub Repository
						</a>
					</div>

					<div class="hero-shortcut">
						<span>Quick Launcher:</span> <kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>K</kbd>
					</div>
				</div>
			</section>

			<!-- MAIN FEATURES GRID -->
			<section id="features">
				<div class="container">
					<div class="section-header">
						<div class="mono-tag">Core Subsystems</div>
						<h2 class="section-heading">Everything you need for remote management</h2>
					</div>

					<div class="bento-grid">
						<!-- Feature 1 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-blue">TERMINAL ENGINE</span>
							</div>
							<h3>WebGL Terminal & Zmodem Transfers</h3>
							<p>
								Ultra-fast terminal emulator powered by Xterm.js with WebGL acceleration, search addons, and inline sz/rz Zmodem file transfers directly inside active sessions.
							</p>
						</div>

						<!-- Feature 2 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-purple">VAULT SECURITY</span>
							</div>
							<h3>Zero-Knowledge Encrypted Vault</h3>
							<p>
								Store server connections and private keys safely. Encrypted with Scrypt key derivation and AES-256-GCM authenticated encryption. Memory buffers are wiped when locked.
							</p>
						</div>

						<!-- Feature 3 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-green">FILE MANAGER</span>
							</div>
							<h3>SFTP Browser & Remote Editor</h3>
							<p>
								Multi-pane remote file explorer supporting drag-and-drop file transfers, direct file editing, permission management, and single-click directory archiving (.tar.gz / .zip).
							</p>
						</div>

						<!-- Feature 4 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-amber">NETWORKING</span>
							</div>
							<h3>Bastion Hosts & Port Tunneling</h3>
							<p>
								Connect to isolated remote networks via SSH jump hosts. Establish and monitor Local (-L) and Remote (-R) SSH port forwarding tunnels with live port status checks.
							</p>
						</div>

						<!-- Feature 5 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-purple">TELEMETRY</span>
							</div>
							<h3>Live System Vitals Telemetry</h3>
							<p>
								Monitor real-time CPU, RAM, and Disk metrics polled every 3000ms. Compatible with Ubuntu, Debian, CentOS, RHEL, Arch, Alpine Linux, and macOS/BSD hosts.
							</p>
						</div>

						<!-- Feature 6 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-blue">AUTOMATION</span>
							</div>
							<h3>Parallel Multi-Server Script Execution</h3>
							<p>
								Execute shell scripts across multiple remote servers simultaneously. Includes real-time log aggregation and reusable command templates with ${"{variable}"} substitution.
							</p>
						</div>

						<!-- Feature 7 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-green">RECORDING</span>
							</div>
							<h3>ANSI Session Recording & Replay</h3>
							<p>
								Record terminal sessions with microsecond precision. Replay session recordings inside Aegis using integrated playback controls (Play, Pause, 1x-4x Speed, and timeline scrub bar).
							</p>
						</div>

						<!-- Feature 8 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-amber">EXTENSIBILITY</span>
							</div>
							<h3>Custom Plugins & Theme Color Palettes</h3>
							<p>
								Extend Aegis functionality with custom JavaScript plugins and personalize UI theme color palettes to match your workstation preference.
							</p>
						</div>

						<!-- Feature 9 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-purple">POLICY CONTROL</span>
							</div>
							<h3>Enterprise Security Policies</h3>
							<p>
								Enforce password complexity rules, restrict port forwarding tunnel creation globally, and restrict SSH negotiation to approved ciphers.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- FEATURED RELEASE ARTICLE -->
			<section id="blog-highlight">
				<div class="container">
					<div class="section-header">
						<div class="mono-tag">Latest Article</div>
						<h2 class="section-heading">Release Notes &amp; Updates</h2>
					</div>

					<a href="/blog/v1-0-0-release" class="bento-card blog-highlight-card">
						<div class="card-meta">
							<span class="pastel-tag tag-blue">RELEASE ANNOUNCEMENT</span>
							<span class="mono-tag">AUGUST 8, 2026</span>
						</div>
						<h3>Announcing Aegis v1.0.0: Zero-Trust Remote Environment Workstation</h3>
						<p>
							Read our full release post covering WebGL terminal rendering, Zmodem inline file transfers, Scrypt vault encryption, parallel multi-server automation, live system vitals telemetry, and installer downloads.
						</p>
						<div class="read-more">Read Full Article &rarr;</div>
					</a>
				</div>
			</section>

			<!-- FAUX-OS ARCHITECTURE WINDOW -->
			<section id="architecture">
				<div class="container">
					<div class="section-header">
						<div class="mono-tag">System Topology</div>
						<h2 class="section-heading">Built on modern, isolated architecture</h2>
					</div>

					<div class="window-chrome">
						<div class="window-header">
							<div class="window-dots">
								<span class="dot"></span>
								<span class="dot"></span>
								<span class="dot"></span>
							</div>
							<div class="window-title">aegis-topology.sys</div>
						</div>
						<div class="window-body">
							<div class="topo-block">
								<div class="topo-title">RENDERER INTERFACE [React 19 + Vite]</div>
								<div class="topo-desc">Xterm.js Terminal Viewport // SFTP Explorer // System Vitals Bar // Batch Automation</div>
							</div>
							<div class="topo-divider">↓ SECURE PRELOAD IPC BRIDGE ↓</div>
							<div class="topo-block">
								<div class="topo-title">DESKTOP MAIN PROCESS [Electron 43.3 / Node 22]</div>
								<div class="topo-desc">Scrypt Vault // SSH2 Proxy & Bastion Router // Local PTY // Vitals Parser</div>
							</div>
							<div class="topo-divider">↓ ENCRYPTED NETWORK PROTOCOLS ↓</div>
							<div class="topo-block">
								<div class="topo-title">TARGET INFRASTRUCTURE</div>
								<div class="topo-desc">Ubuntu / Debian / RHEL / Arch / Alpine / macOS / BSD Hosts</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- RELEASES CTA -->
			<section class="cta-section">
				<div class="container">
					<div class="cta-card">
						<h2 class="editorial-title">Ready to deploy Aegis?</h2>
						<p class="cta-desc">
							Download Aegis v1.0.0 for Windows (NSIS Installer) or inspect the open-source repository on GitHub.
						</p>
						<div class="cta-actions">
							<a href="https://github.com/mukeshv-tech/Aegis/releases/" target="_blank" rel="noopener" class="btn btn-primary">
								View GitHub Releases (v1.0.0)
							</a>
							<a href="https://github.com/mukeshv-tech/Aegis" target="_blank" rel="noopener" class="btn btn-secondary">
								Source Repository
							</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero-section {
		padding: 7rem 0 5rem 0;
	}
	.hero-meta {
		margin-bottom: 1.5rem;
	}
	.hero-heading {
		max-width: 900px;
		margin-bottom: 1.5rem;
	}
	.hero-desc {
		font-size: 1.15rem;
		color: var(--text-muted);
		max-width: 720px;
		line-height: 1.7;
		margin-bottom: 2.5rem;
	}
	.hero-actions {
		display: flex;
		gap: 1rem;
		margin-bottom: 2rem;
		flex-wrap: wrap;
	}
	.hero-shortcut {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--text-dim);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	/* Section Headers */
	.section-header {
		margin-bottom: 3rem;
	}
	.section-heading {
		font-size: 2rem;
		font-weight: 700;
		margin-top: 0.5rem;
		letter-spacing: -0.02em;
	}

	/* Bento Grid */
	.bento-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 1.5rem;
	}
	.card-meta {
		margin-bottom: 1.25rem;
	}
	.bento-card h3 {
		font-size: 1.15rem;
		font-weight: 700;
		margin-bottom: 0.75rem;
		color: var(--text-main);
	}
	.bento-card p {
		font-size: 0.875rem;
		color: var(--text-muted);
		line-height: 1.6;
	}

	/* Faux-OS Window */
	.window-chrome {
		background: var(--bg-surface);
		border: 1px solid var(--border-light);
		border-radius: 8px;
		overflow: hidden;
	}
	.window-header {
		background: var(--bg-card);
		border-bottom: 1px solid var(--border-light);
		padding: 0.75rem 1.25rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.window-dots {
		display: flex;
		gap: 0.4rem;
	}
	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--border-strong);
	}
	.window-title {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-dim);
	}
	.window-body {
		padding: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		align-items: center;
	}
	.topo-block {
		width: 100%;
		max-width: 700px;
		background: var(--bg-card);
		border: 1px solid var(--border-light);
		border-radius: 6px;
		padding: 1.25rem;
		text-align: center;
	}
	.topo-title {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--text-main);
		margin-bottom: 0.35rem;
	}
	.topo-desc {
		font-size: 0.8125rem;
		color: var(--text-muted);
	}
	.topo-divider {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--pastel-blue-text);
		font-weight: 600;
	}

	/* CTA Card */
	.cta-card {
		background: var(--bg-surface);
		border: 1px solid var(--border-strong);
		border-radius: 8px;
		padding: 4rem 2rem;
		text-align: center;
	}
	.cta-desc {
		color: var(--text-muted);
		font-size: 1.1rem;
		max-width: 600px;
		margin: 1rem auto 2.5rem auto;
	}
	.cta-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Hero Announcement Banner */
	.hero-banner {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		background: var(--bg-surface);
		border: 1px solid var(--border-light);
		border-radius: 9999px;
		padding: 0.35rem 1rem 0.35rem 0.5rem;
		margin-bottom: 1.5rem;
		transition: border-color 0.2s ease;
	}
	.hero-banner:hover {
		border-color: var(--border-strong);
	}
	.banner-text {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--text-main);
	}

	/* Featured Blog Card */
	.blog-highlight-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		text-decoration: none;
	}
	.blog-highlight-card h3 {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--text-main);
	}
	.blog-highlight-card p {
		font-size: 1rem;
		color: var(--text-muted);
		line-height: 1.6;
	}
	.read-more {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--pastel-blue-text);
		margin-top: 0.5rem;
	}
</style>
