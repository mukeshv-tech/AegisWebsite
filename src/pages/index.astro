---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<!-- HERO SECTION -->
			<section class="hero-section">
				<div class="container">
					<div class="mono-tag hero-meta">Zero-Trust Environment Workstation</div>
					
					<h1 class="editorial-title hero-heading">
						Command remote infrastructure with <em>zero-trust precision.</em>
					</h1>

					<p class="hero-desc">
						Aegis is an enterprise desktop workstation combining WebGL terminal emulation, zero-knowledge Scrypt vault encryption, parallel multi-server execution, and cross-distro vitals telemetry into a unified local environment.
					</p>

					<div class="hero-actions">
						<a href="https://github.com/mukeshv-tech/Aegis/releases/" target="_blank" rel="noopener" class="btn btn-primary">
							View Releases (v1.0.0)
						</a>
						<a href="https://github.com/mukeshv-tech/Aegis" target="_blank" rel="noopener" class="btn btn-secondary">
							GitHub Repository
						</a>
					</div>

					<div class="hero-shortcut">
						<span>Quick Launcher:</span> <kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>K</kbd>
					</div>
				</div>
			</section>

			<!-- BENTO FEATURES GRID -->
			<section id="features">
				<div class="container">
					<div class="section-header">
						<div class="mono-tag">Subsystem Architecture</div>
						<h2 class="section-heading">Built for High-Consequence Operations</h2>
					</div>

					<div class="bento-grid">
						<!-- Bento Card 1 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-purple">CRYPTO VAULT</span>
							</div>
							<h3>Zero-Knowledge Cryptographic Vault</h3>
							<p>
								Secured with GPU-resistant Scrypt key derivation (N=16384, r=8, p=1) and AES-256-GCM authenticated encryption. Decrypted master key allocations in process memory are zero-filled immediately upon vault locking.
							</p>
						</div>

						<!-- Bento Card 2 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-blue">TERMINAL ENGINE</span>
							</div>
							<h3>WebGL Terminal & Native Zmodem</h3>
							<p>
								Powered by @xterm/xterm v5.5 with WebGL acceleration, search addons, and clickable web links. Features native inline sz and rz Zmodem file transfers directly inside active terminal viewports.
							</p>
						</div>

						<!-- Bento Card 3 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-green">FILE MANAGER</span>
							</div>
							<h3>SFTP Browser & Remote Editor</h3>
							<p>
								Multi-pane remote file explorer supporting drag-and-drop uploads, live code editing, permission management, and single-click remote directory compression and extraction (.tar.gz / .zip).
							</p>
						</div>

						<!-- Bento Card 4 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-amber">NETWORKING</span>
							</div>
							<h3>Bastion Hosts & Port Tunneling</h3>
							<p>
								Native multi-hop SSH proxy forwarding via sshClient.forwardOut() for isolated VPCs. Establish and monitor Local (-L) and Remote (-R) SSH port forwarding tunnels with real-time port validation.
							</p>
						</div>

						<!-- Bento Card 5 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-purple">TELEMETRY</span>
							</div>
							<h3>Cross-Distro System Vitals</h3>
							<p>
								Single-pipe telemetric parser delivering live CPU, RAM, and Disk metrics every 3000ms. Compatible with Ubuntu, Debian, CentOS, RHEL, Arch, Alpine (BusyBox), and macOS/BSD hosts.
							</p>
						</div>

						<!-- Bento Card 6 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-blue">AUTOMATION</span>
							</div>
							<h3>Parallel Multi-Server Execution</h3>
							<p>
								Execute shell automation scripts across multiple remote servers simultaneously. Features real-time log aggregation and reusable snippet templates with ${"{variable}"} substitution.
							</p>
						</div>

						<!-- Bento Card 7 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-green">AUDIT LOGGING</span>
							</div>
							<h3>ANSI Session Recording & Replay</h3>
							<p>
								Record terminal sessions with microsecond precision. Replay sessions inside Aegis using integrated playback controls (Play, Pause, 1x-4x Speed, and timeline scrubbing).
							</p>
						</div>

						<!-- Bento Card 8 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-amber">EXTENSIBILITY</span>
							</div>
							<h3>Dynamic Plugin Engine & Styling</h3>
							<p>
								Extend functionality via custom JavaScript plugins loaded dynamically with JSDoc metadata parsing. Customize themes and styling with the built-in aegisApi color palette bridge.
							</p>
						</div>

						<!-- Bento Card 9 -->
						<div class="bento-card">
							<div class="card-meta">
								<span class="pastel-tag tag-purple">POLICY ENGINE</span>
							</div>
							<h3>Enterprise Security Policies</h3>
							<p>
								Enforce master password complexity rules, restrict port forwarding creation globally, and limit SSH negotiation to approved ciphers (AES-GCM and ChaCha20-Poly1305).
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- SECURITY SPECIFICATION -->
			<section id="security">
				<div class="container">
					<div class="section-header">
						<div class="mono-tag">Threat Model & Hardening</div>
						<h2 class="section-heading">Zero-Trust Cryptographic Standard</h2>
					</div>

					<div class="spec-table">
						<div class="spec-row">
							<div class="spec-key">Key Derivation</div>
							<div class="spec-val">Scrypt (N=16384, r=8, p=1) with 16-byte random salts</div>
						</div>
						<div class="spec-row">
							<div class="spec-key">Authenticated Encryption</div>
							<div class="spec-val">AES-256-GCM with 96-bit random IVs and 128-bit authentication tags</div>
						</div>
						<div class="spec-row">
							<div class="spec-key">Process RAM Safety</div>
							<div class="spec-val">Decrypted master key allocations zero-filled (masterKey.fill(0)) on vault lock</div>
						</div>
						<div class="spec-row">
							<div class="spec-key">Command Escaping</div>
							<div class="spec-val">escapeShellArg single-quote encapsulation preventing subshell injection</div>
						</div>
						<div class="spec-row">
							<div class="spec-key">Path Traversal Guards</div>
							<div class="spec-val">path.basename() bounds checking on key generation and plugin file paths</div>
						</div>
						<div class="spec-row">
							<div class="spec-key">TOCTOU Race Condition Removal</div>
							<div class="spec-val">Atomic store operations inside try/catch blocks without non-atomic existsSync pre-checks</div>
						</div>
					</div>
				</div>
			</section>

			<!-- FAUX-OS ARCHITECTURE WINDOW -->
			<section id="architecture">
				<div class="container">
					<div class="section-header">
						<div class="mono-tag">System Topology</div>
						<h2 class="section-heading">Process Isolation & Architecture</h2>
					</div>

					<!-- Faux-OS Window Chrome -->
					<div class="window-chrome">
						<div class="window-header">
							<div class="window-dots">
								<span class="dot"></span>
								<span class="dot"></span>
								<span class="dot"></span>
							</div>
							<div class="window-title">aegis-topology.sys</div>
						</div>
						<div class="window-body">
							<div class="topo-block">
								<div class="topo-title">RENDERER PROCESS [React 19 + Vite]</div>
								<div class="topo-desc">Xterm.js Terminal Viewport // SFTP Explorer // Vitals Bar // Batch Engine</div>
							</div>
							<div class="topo-divider">↓ SECURE PRELOAD IPC BRIDGE (Context Isolation) ↓</div>
							<div class="topo-block">
								<div class="topo-title">MAIN PROCESS [Electron 43.3 / Node 22]</div>
								<div class="topo-desc">Scrypt Vault // SSH2 Bastion Proxy // Local PTY // Vitals Telemetry Parser</div>
							</div>
							<div class="topo-divider">↓ ENCRYPTED NETWORK PROTOCOLS ↓</div>
							<div class="topo-block">
								<div class="topo-title">TARGET INFRASTRUCTURE</div>
								<div class="topo-desc">Ubuntu / Debian / RHEL / Arch / Alpine / macOS / BSD Hosts</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- VERIFICATION MATRIX -->
			<section id="qa">
				<div class="container">
					<div class="section-header">
						<div class="mono-tag">Quality Gate</div>
						<h2 class="section-heading">Automated Verification Matrix</h2>
					</div>

					<div class="matrix-grid">
						<div class="matrix-card">
							<div class="matrix-val">40 / 40</div>
							<div class="matrix-label">Integration Tests Passing</div>
						</div>
						<div class="matrix-card">
							<div class="matrix-val">12 / 12</div>
							<div class="matrix-label">Test Suites Validated</div>
						</div>
						<div class="matrix-card">
							<div class="matrix-val">0</div>
							<div class="matrix-label">TypeScript & ESLint Errors</div>
						</div>
					</div>
				</div>
			</section>

			<!-- RELEASES CTA -->
			<section class="cta-section">
				<div class="container">
					<div class="cta-card">
						<h2 class="editorial-title">Ready to deploy Aegis?</h2>
						<p class="cta-desc">
							Download Aegis v1.0.0 for Windows (NSIS Installer) or inspect the open-source repository on GitHub.
						</p>
						<div class="cta-actions">
							<a href="https://github.com/mukeshv-tech/Aegis/releases/" target="_blank" rel="noopener" class="btn btn-primary">
								View GitHub Releases (v1.0.0)
							</a>
							<a href="https://github.com/mukeshv-tech/Aegis" target="_blank" rel="noopener" class="btn btn-secondary">
								Source Repository
							</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero-section {
		padding: 7rem 0 5rem 0;
	}
	.hero-meta {
		margin-bottom: 1.5rem;
	}
	.hero-heading {
		max-width: 900px;
		margin-bottom: 1.5rem;
	}
	.hero-desc {
		font-size: 1.15rem;
		color: var(--text-muted);
		max-width: 720px;
		line-height: 1.7;
		margin-bottom: 2.5rem;
	}
	.hero-actions {
		display: flex;
		gap: 1rem;
		margin-bottom: 2rem;
		flex-wrap: wrap;
	}
	.hero-shortcut {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--text-dim);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	/* Section Headers */
	.section-header {
		margin-bottom: 3rem;
	}
	.section-heading {
		font-size: 2rem;
		font-weight: 700;
		margin-top: 0.5rem;
		letter-spacing: -0.02em;
	}

	/* Bento Grid */
	.bento-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 1.5rem;
	}
	.card-meta {
		margin-bottom: 1.25rem;
	}
	.bento-card h3 {
		font-size: 1.15rem;
		font-weight: 700;
		margin-bottom: 0.75rem;
		color: var(--text-main);
	}
	.bento-card p {
		font-size: 0.875rem;
		color: var(--text-muted);
		line-height: 1.6;
	}

	/* Spec Table */
	.spec-table {
		border: 1px solid var(--border-light);
		border-radius: 8px;
		background: var(--bg-surface);
		overflow: hidden;
	}
	.spec-row {
		display: grid;
		grid-template-columns: 240px 1fr;
		padding: 1.25rem 1.75rem;
		border-bottom: 1px solid var(--border-light);
	}
	.spec-row:last-child {
		border-bottom: none;
	}
	.spec-key {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--text-main);
	}
	.spec-val {
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	/* Faux-OS Window */
	.window-chrome {
		background: var(--bg-surface);
		border: 1px solid var(--border-light);
		border-radius: 8px;
		overflow: hidden;
	}
	.window-header {
		background: var(--bg-card);
		border-bottom: 1px solid var(--border-light);
		padding: 0.75rem 1.25rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.window-dots {
		display: flex;
		gap: 0.4rem;
	}
	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--border-strong);
	}
	.window-title {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-dim);
	}
	.window-body {
		padding: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		align-items: center;
	}
	.topo-block {
		width: 100%;
		max-width: 700px;
		background: var(--bg-card);
		border: 1px solid var(--border-light);
		border-radius: 6px;
		padding: 1.25rem;
		text-align: center;
	}
	.topo-title {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--text-main);
		margin-bottom: 0.35rem;
	}
	.topo-desc {
		font-size: 0.8125rem;
		color: var(--text-muted);
	}
	.topo-divider {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--pastel-blue-text);
		font-weight: 600;
	}

	/* Verification Matrix */
	.matrix-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
	}
	.matrix-card {
		background: var(--bg-surface);
		border: 1px solid var(--border-light);
		border-radius: 8px;
		padding: 2rem;
		text-align: center;
	}
	.matrix-val {
		font-family: var(--font-mono);
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--text-main);
		margin-bottom: 0.5rem;
	}
	.matrix-label {
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	/* CTA Card */
	.cta-card {
		background: var(--bg-surface);
		border: 1px solid var(--border-strong);
		border-radius: 8px;
		padding: 4rem 2rem;
		text-align: center;
	}
	.cta-desc {
		color: var(--text-muted);
		font-size: 1.1rem;
		max-width: 600px;
		margin: 1rem auto 2.5rem auto;
	}
	.cta-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	@media (max-width: 768px) {
		.spec-row {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>
