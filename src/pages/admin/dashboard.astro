---
export const prerender = false;

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { verifyAdminSession, DEFAULT_ADMIN_PASSWORD } from '../../lib/auth';

// Disable browser caching for admin dashboard
Astro.response.headers.set("Cache-Control", "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0");
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("Expires", "0");

const envPassword = process.env.ADMIN_PASSWORD || DEFAULT_ADMIN_PASSWORD;
const isAuthenticated = await verifyAdminSession(Astro.request, envPassword);

if (!isAuthenticated) {
	return Astro.redirect('/admin/login');
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Admin Dashboard — Aegis CMS" description="Manage blog posts and release notes for Aegis." />
	</head>
	<body>
		<Header />

		<main class="dashboard-main">
			<div class="container">
				<!-- TOP HEADER BAR -->
				<div class="dash-top">
					<div>
						<div class="mono-tag">Authenticated Master Session</div>
						<h1 class="editorial-title dash-heading">Blog CMS Dashboard</h1>
					</div>
					<button id="logout-btn" class="btn btn-secondary">Logout</button>
				</div>

				<!-- CREATE POST FORM -->
				<div class="bento-card dash-card">
					<div class="card-meta">
						<span class="pastel-tag tag-blue">NEW ARTICLE EDITOR</span>
					</div>

					<form id="post-form" class="post-form">
						<div class="form-grid">
							<div class="form-group">
								<label for="title" class="mono-tag">Article Title</label>
								<input type="text" id="title" required placeholder="e.g. Announcing Aegis v1.1.0 Feature Suite" class="form-input" />
							</div>

							<div class="form-group">
								<label for="slug" class="mono-tag">URL Slug</label>
								<input type="text" id="slug" required placeholder="v1-1-0-update" class="form-input" />
							</div>
						</div>

						<div class="form-grid">
							<div class="form-group">
								<label for="category" class="mono-tag">Category</label>
								<input type="text" id="category" value="Release Announcement" class="form-input" />
							</div>

							<div class="form-group">
								<label for="author" class="mono-tag">Author</label>
								<input type="text" id="author" value="Mukesh (@mukeshv-tech)" class="form-input" />
							</div>
						</div>

						<div class="form-group">
							<label for="description" class="mono-tag">Short Summary / Description</label>
							<input type="text" id="description" required placeholder="Short 1-2 sentence preview for article cards." class="form-input" />
						</div>

						<div class="form-group">
							<label for="content" class="mono-tag">Markdown Article Content</label>
							<textarea id="content" required rows="10" placeholder="Write article content in Markdown format..." class="form-textarea"></textarea>
						</div>

						<div id="status-msg" class="status-msg" style="display: none;"></div>

						<button type="submit" id="publish-btn" class="btn btn-primary btn-lg">
							Publish Article to Database &rarr;
						</button>
					</form>
				</div>

				<!-- MANAGE ARTICLES & TRASH -->
				<div class="bento-card dash-card" style="margin-top: 3rem;">
					<div class="card-meta">
						<span class="pastel-tag tag-purple">DATABASE MANAGEMENT</span>
					</div>
					<h2 class="section-heading">Published Articles &amp; Trash</h2>

					<!-- ACTIVE PUBLISHED ARTICLES -->
					<div class="manage-section">
						<h3 class="manage-subtitle">Active Published Articles</h3>
						<div id="active-list" class="articles-list">
							<div class="loading-text">Loading articles from D1 database...</div>
						</div>
					</div>

					<!-- TRASH / DELETED ARTICLES -->
					<div class="manage-section" style="margin-top: 2.5rem;">
						<h3 class="manage-subtitle" style="color: var(--pastel-amber-text);">Trash &amp; Archived Articles</h3>
						<div id="trash-list" class="articles-list">
							<div class="loading-text">Loading trash items...</div>
						</div>
					</div>
				</div>
			</div>
		</main>

		<Footer />

		<script>
			// Auto slug generator
			const titleInput = document.getElementById('title') as HTMLInputElement;
			const slugInput = document.getElementById('slug') as HTMLInputElement;

			titleInput?.addEventListener('input', () => {
				if (!slugInput.dataset.manual) {
					slugInput.value = titleInput.value
						.toLowerCase()
						.trim()
						.replace(/[^a-z0-9 -]/g, '')
						.replace(/\s+/g, '-');
				}
			});

			slugInput?.addEventListener('input', () => {
				slugInput.dataset.manual = 'true';
			});

			// Form submission
			const form = document.getElementById('post-form') as HTMLFormElement;
			const statusMsg = document.getElementById('status-msg') as HTMLDivElement;
			const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement;

			form?.addEventListener('submit', async (e) => {
				e.preventDefault();
				statusMsg.style.display = 'none';
				publishBtn.disabled = true;
				publishBtn.innerText = 'Publishing to Database...';

				const postData = {
					title: (document.getElementById('title') as HTMLInputElement).value,
					slug: (document.getElementById('slug') as HTMLInputElement).value,
					category: (document.getElementById('category') as HTMLInputElement).value,
					author: (document.getElementById('author') as HTMLInputElement).value,
					description: (document.getElementById('description') as HTMLInputElement).value,
					content: (document.getElementById('content') as HTMLTextAreaElement).value,
				};

				try {
					const res = await fetch('/api/posts', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(postData),
					});

					const data = await res.json();

					if (res.ok && data.success) {
						statusMsg.className = 'status-msg status-success';
						statusMsg.innerText = data.message || `Published successfully!`;
						statusMsg.style.display = 'block';
						form.reset();
						loadArticles();
					} else {
						statusMsg.className = 'status-msg status-error';
						statusMsg.innerText = data.error || 'Failed to publish post';
						statusMsg.style.display = 'block';
					}
				} catch (err: any) {
					statusMsg.className = 'status-msg status-error';
					statusMsg.innerText = 'Network connection error';
					statusMsg.style.display = 'block';
				} finally {
					publishBtn.disabled = false;
					publishBtn.innerText = 'Publish Article to Database →';
				}
			});

			// Fetch and render articles list
			async function loadArticles() {
				const activeList = document.getElementById('active-list') as HTMLDivElement;
				const trashList = document.getElementById('trash-list') as HTMLDivElement;

				try {
					const res = await fetch('/api/posts');
					const posts = await res.json();

					const activePosts = posts.filter((p: any) => !p.is_deleted || p.is_deleted === 0);
					const trashPosts = posts.filter((p: any) => p.is_deleted === 1);

					// Render Active List
					if (activePosts.length === 0) {
						activeList.innerHTML = '<div class="empty-text">No active published articles.</div>';
					} else {
						activeList.innerHTML = activePosts.map((p: any) => `
							<div class="article-row">
								<div class="article-info">
									<div class="article-title">${p.title}</div>
									<div class="article-meta">Slug: <code>/blog/${p.slug}</code> | Published: ${p.pub_date || p.pubDate}</div>
								</div>
								<div class="article-actions">
									<button class="btn btn-secondary btn-sm delete-btn" data-slug="${p.slug}">🗑️ Move to Trash</button>
								</div>
							</div>
						`).join('');
					}

					// Render Trash List
					if (trashPosts.length === 0) {
						trashList.innerHTML = '<div class="empty-text">Trash is empty.</div>';
					} else {
						trashList.innerHTML = trashPosts.map((p: any) => `
							<div class="article-row trash-row">
								<div class="article-info">
									<div class="article-title">${p.title}</div>
									<div class="article-meta">Slug: <code>/blog/${p.slug}</code> | Status: In Trash</div>
								</div>
								<div class="article-actions">
									<button class="btn btn-secondary btn-sm restore-btn" data-slug="${p.slug}">🔄 Restore Article</button>
									<button class="btn btn-secondary btn-sm perm-delete-btn" data-slug="${p.slug}" style="color: #f87171;">❌ Delete Permanently</button>
								</div>
							</div>
						`).join('');
					}

					// Bind event listeners
					document.querySelectorAll('.delete-btn').forEach(btn => {
						btn.addEventListener('click', () => handlePostAction(btn.getAttribute('data-slug')!, 'delete'));
					});
					document.querySelectorAll('.restore-btn').forEach(btn => {
						btn.addEventListener('click', () => handlePostAction(btn.getAttribute('data-slug')!, 'restore'));
					});
					document.querySelectorAll('.perm-delete-btn').forEach(btn => {
						btn.addEventListener('click', () => {
							if (confirm('Are you sure you want to permanently delete this article? This action cannot be undone.')) {
								handlePostAction(btn.getAttribute('data-slug')!, 'permanent_delete');
							}
						});
					});

				} catch (err) {
					activeList.innerHTML = '<div class="empty-text">Failed to load articles.</div>';
					trashList.innerHTML = '';
				}
			}

			async function handlePostAction(slug: string, action: 'delete' | 'restore' | 'permanent_delete') {
				try {
					const res = await fetch('/api/posts', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ action, slug }),
					});
					const data = await res.json();
					if (data.success) {
						loadArticles();
					} else {
						alert(data.error || 'Action failed');
					}
				} catch (err) {
					alert('Network error while processing action');
				}
			}

			// Initial load
			loadArticles();

			// Logout
			const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;
			logoutBtn?.addEventListener('click', async () => {
				try {
					await fetch('/api/auth/logout', { method: 'POST' });
				} catch (e) {}
				sessionStorage.clear();
				localStorage.clear();
				window.location.replace('/admin/login');
			});
		</script>
	</body>
</html>

<style>
	.dashboard-main {
		padding: 4rem 0 6rem 0;
		min-height: 80vh;
	}
	.dash-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2.5rem;
		border-bottom: 1px solid var(--border-light);
		padding-bottom: 2rem;
	}
	.dash-heading {
		font-size: 2.5rem;
		margin-top: 0.5rem;
	}
	.dash-card {
		padding: 3rem 2.5rem;
	}
	.post-form {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}
	.form-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}
	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.form-input, .form-textarea {
		background: var(--bg-card);
		border: 1px solid var(--border-light);
		border-radius: 6px;
		padding: 0.875rem 1rem;
		font-family: var(--font-sans);
		font-size: 0.95rem;
		color: var(--text-main);
		outline: none;
		transition: border-color 0.2s ease;
	}
	.form-textarea {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		line-height: 1.6;
		resize: vertical;
	}
	.form-input:focus, .form-textarea:focus {
		border-color: var(--border-strong);
	}
	.status-msg {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		padding: 0.75rem 1rem;
		border-radius: 6px;
	}
	.status-success {
		color: var(--pastel-green-text);
		background: var(--pastel-green-bg);
		border: 1px solid rgba(52, 211, 153, 0.2);
	}
	.status-error {
		color: #f87171;
		background: rgba(248, 113, 113, 0.1);
		border: 1px solid rgba(248, 113, 113, 0.2);
	}

	/* Article List Management Styles */
	.manage-subtitle {
		font-size: 1.15rem;
		font-weight: 700;
		margin-bottom: 1rem;
	}
	.articles-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.article-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: var(--bg-primary);
		border: 1px solid var(--border-light);
		border-radius: 6px;
		padding: 1rem 1.25rem;
	}
	.trash-row {
		opacity: 0.8;
		border-style: dashed;
	}
	.article-title {
		font-weight: 600;
		font-size: 1rem;
		color: var(--text-main);
	}
	.article-meta {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-dim);
		margin-top: 0.25rem;
	}
	.article-actions {
		display: flex;
		gap: 0.5rem;
	}
	.btn-sm {
		padding: 0.4rem 0.75rem;
		font-size: 0.8125rem;
	}
	.loading-text, .empty-text {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--text-dim);
		padding: 1rem 0;
	}

	@media (max-width: 768px) {
		.form-grid {
			grid-template-columns: 1fr;
		}
		.article-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
	}
</style>
