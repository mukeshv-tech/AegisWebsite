---
export const prerender = false;

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { INITIAL_POSTS, type BlogPostItem } from '../../lib/posts';

const { slug } = Astro.params;
let post: BlogPostItem | null = null;

// 1. Query Cloudflare D1 Database for matching slug
try {
	const runtime = (Astro.locals as any)?.runtime;
	const db = runtime?.env?.DB;

	if (db && slug) {
		const { results } = await db.prepare("SELECT * FROM posts WHERE slug = ? OR id = ?").bind(slug, slug).all();
		if (results && results.length > 0) {
			post = results[0] as BlogPostItem;
		}
	}
} catch (d1Err) {
	console.warn("D1 query fallback for single post:", d1Err);
}

// 2. Fallback to INITIAL_POSTS if D1 lookup yields no match
if (!post && slug) {
	post = INITIAL_POSTS.find((p) => p.slug === slug || p.id === slug) || null;
}

if (!post) {
	return Astro.redirect('/blog');
}

// Basic markdown to HTML formatting helper for dynamic D1 content
function renderMarkdownHTML(content: string): string {
	if (!content) return '';
	return content
		.replace(/^### (.*$)/gim, '<h3>$1</h3>')
		.replace(/^## (.*$)/gim, '<h2>$1</h2>')
		.replace(/^# (.*$)/gim, '<h1>$1</h1>')
		.replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>')
		.replace(/\*(.*?)\*/gim, '<em>$1</em>')
		.replace(/`([^`]+)`/gim, '<code>$1</code>')
		.replace(/\[([^\]]+)\]\(([^)]+)\)/gim, '<a href="$2" target="_blank" rel="noopener">$1</a>')
		.replace(/\n\n/gim, '</p><p>')
		.replace(/\n/gim, '<br />');
}

const htmlContent = renderMarkdownHTML(post.content || '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${post.title} — Aegis Blog`} description={post.description} />
	</head>
	<body>
		<Header />

		<main class="post-main">
			<article class="container post-container">
				<div class="post-header">
					<a href="/blog" class="back-link">&larr; Back to Articles</a>
					<div class="post-meta">
						<span class="pastel-tag tag-blue">{post.category || 'Release Announcement'}</span>
						<time datetime={post.pubDate} class="mono-date">
							{post.pubDate}
						</time>
					</div>
					<h1 class="editorial-title post-heading">{post.title}</h1>
					<div class="author-bar">Published by {post.author || 'Mukesh (@mukeshv-tech)'}</div>
				</div>

				<div class="markdown-body" set:html={`<p>${htmlContent}</p>`} />
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	.post-main {
		padding: 5rem 0;
	}
	.post-container {
		max-width: 800px;
	}
	.back-link {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--text-dim);
		display: inline-block;
		margin-bottom: 2rem;
	}
	.back-link:hover {
		color: var(--text-main);
	}
	.post-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}
	.mono-date {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--text-dim);
	}
	.post-heading {
		font-size: 3rem;
		line-height: 1.15;
		margin-bottom: 1.5rem;
	}
	.author-bar {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--text-dim);
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border-light);
		margin-bottom: 3rem;
	}

	/* Markdown Content Styling */
	.markdown-body {
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--text-muted);
	}
	.markdown-body :global(h2) {
		font-size: 1.75rem;
		font-weight: 700;
		color: var(--text-main);
		margin: 2.5rem 0 1rem 0;
	}
	.markdown-body :global(h3) {
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--text-main);
		margin: 2rem 0 0.75rem 0;
	}
	.markdown-body :global(h4) {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text-main);
		margin: 1.5rem 0 0.5rem 0;
	}
	.markdown-body :global(p) {
		margin-bottom: 1.5rem;
	}
	.markdown-body :global(ul), .markdown-body :global(ol) {
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}
	.markdown-body :global(li) {
		margin-bottom: 0.5rem;
	}
	.markdown-body :global(hr) {
		border: none;
		border-top: 1px solid var(--border-light);
		margin: 3rem 0;
	}
	.markdown-body :global(a) {
		color: var(--pastel-blue-text);
		text-decoration: underline;
	}
	.markdown-body :global(strong) {
		color: var(--text-main);
	}
</style>
